# ==========================================
# Minecraft Mod (Fabric 1.20.1) .gitignore
# ==========================================

# 1. Gradle 构建与依赖缓存
.gradle/
build/
out/
bin/
*.class

# 2. Minecraft 运行测试目录 (Run Directory)
# 模组调试启动时生成的临时世界、日志、崩溃报告与游戏配置
run/
crash-reports/
logs/
saves/
screenshots/
mods/
usercache.json
usernamecache.json

# 3. 关键敏感信息隔离 (AI 模组特有防泄露规则)
# 严禁将包含 API Key 的配置文件推送到公共代码库！
**/config/minecompanion/config.json
**/config/minecompanion/memories/
*.env
*.key
*.token

# 4. IDE 与编辑器配置文件
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.settings/
.project
.classpath

# 5. 操作系统产生的文件
.DS_Store
Thumbs.db
desktop.ini

# 6. 打包产物与压缩包（正式版通过 GitHub Releases 发布）
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.zip
*.tar.gz
